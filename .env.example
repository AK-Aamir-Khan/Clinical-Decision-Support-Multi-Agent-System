# Copy this file to .env and fill in your own values. Never commit .env.
# Leave both OPENAI_API_KEY and OPENAI_BASE_URL unset to run in rule-based mode.

# --- Option A: OpenAI API ---------------------------------------------------
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Option B: local model with Ollama (no API key needed) -------------------
# 1) ollama pull gemma3:4b     2) make sure Ollama is running     3) use:
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=gemma3:4b
# (json_mode is used automatically for local servers; timeout defaults to 180 s)

# --- Optional settings --------------------------------------------------------
LLM_TEMPERATURE=0
# LLM_TIMEOUT_SECONDS=30
# LLM_STRUCTURED_METHOD=function_calling   # function_calling | json_mode | json_schema
LLM_MAX_RETRIES=1
# Set to false to force rule-based mode even when an LLM is configured
USE_LLM=true
RAG_TOP_K=4
MAX_SAFETY_REVISIONS=1
